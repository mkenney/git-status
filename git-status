# Prefer the native-arch binary; fall back to amd64 (runs under Rosetta on Darwin).
platform=`uname`
arch=`uname -m`
__git_status_cmd=
if [ "Darwin" = "$platform" ]; then
    if [ "arm64" = "$arch" ]; then
        which git-status-darwin-arm64 &> /dev/null && __git_status_cmd=git-status-darwin-arm64
    fi
    if [ "" = "$__git_status_cmd" ]; then
        which git-status-darwin-amd64 &> /dev/null && __git_status_cmd=git-status-darwin-amd64
    fi
fi
if [ "Linux" = "$platform" ]; then
    if [ "aarch64" = "$arch" ]; then
        which git-status-linux-arm64 &> /dev/null && __git_status_cmd=git-status-linux-arm64
    elif [ "armv7l" = "$arch" ]; then
        which git-status-linux-armv7 &> /dev/null && __git_status_cmd=git-status-linux-armv7
    fi
    if [ "" = "$__git_status_cmd" ]; then
        which git-status-linux-amd64 &> /dev/null && __git_status_cmd=git-status-linux-amd64
    fi
fi
export __git_status_cmd

__git_status() {
    # execute binary version if available
    if [ "" != "$__git_status_cmd" ]; then
        if [ "-v" = "$1" ]; then
            $__git_status_cmd -v | jq
        else
            echo $($__git_status_cmd)
        fi
        return
    fi

    # Fallback: single git call replaces ~10 sequential git processes.
    # --porcelain=v2 --branch provides oid, branch name, upstream,
    # ahead/behind counts, and all file statuses in one shot.
    local raw
    raw=$(git status --porcelain=v2 --branch 2>/dev/null) || return

    # Parse branch header lines
    local oid head upstream ahead=0 behind=0
    while IFS= read -r line; do
        case "$line" in
            '# branch.oid '*)
                oid="${line#'# branch.oid '}"; oid="${oid:0:10}" ;;
            '# branch.head '*)
                head="${line#'# branch.head '}" ;;
            '# branch.upstream '*)
                upstream="${line#'# branch.upstream '}" ;;
            '# branch.ab '*)
                local ab="${line#'# branch.ab '}"
                ahead="${ab%% *}"; ahead="${ahead#+}"
                behind="${ab##* }"; behind="${behind#-}"
                ;;
        esac
    done <<< "$raw"

    # Determine ref_source and ref_name.
    # Detached HEAD: try tag description (shown as "tag: name (hash)"), fall back to commit hash.
    # Tracking branch: upstream provides "remote/branch" — split into source/name.
    # Local branch: no upstream tracking set.
    local ref_source ref_name
    if [ "(detached)" = "$head" ]; then
        ref_name=$(git describe --exact-match --tags HEAD 2>/dev/null)
        if [ -n "$ref_name" ]; then
            ref_source="tag"
            ref_name="${ref_name} (${oid})"
        else
            ref_name="$oid"
            ref_source="detached"
        fi
    elif [ -n "$upstream" ]; then
        ref_source="$(dirname "$upstream")"
        ref_name="$(basename "$upstream")"
    else
        ref_source="local"
        ref_name="$head"
    fi

    # Count stashed entries without spawning wc.
    local stashed=0
    local stash_raw
    stash_raw=$(git stash list 2>/dev/null)
    while IFS= read -r _stash_line; do
        [ -n "$_stash_line" ] && stashed=$((stashed+1))
    done <<< "$stash_raw"

    # Count file states in a single pass — no subprocesses.
    # Type-1 lines: ordinary changes. X=staged status, Y=unstaged status.
    # Type-2 lines: renames/copies. Type-?: untracked.
    local added=0 deleted=0 staged=0 renamed=0 untracked=0 unstaged=0
    while IFS= read -r line; do
        case "${line:0:1}" in
            '1')
                local x="${line:2:1}" y="${line:3:1}"
                [ "$x" = "A" ]                      && added=$((added+1))
                [ "$x" = "D" ] || [ "$y" = "D" ]    && deleted=$((deleted+1))
                [ "$x" = "M" ] && [ "$y" = "." ]    && staged=$((staged+1))
                [ "$y" != "." ] && [ "$y" != " " ]  && unstaged=$((unstaged+1))
                ;;
            '2')
                renamed=$((renamed+1))
                ;;
            '?')
                untracked=$((untracked+1))
                ;;
        esac
    done <<< "$(grep -v '^#' <<< "$raw")"

    # Build output string. Indicator order matches the binary:
    # untracked, stash, behind, ahead, deleted, added, renamed, staged, unstaged.
    local output=0
    local untracked_str= stash_str= behind_str= ahead_str=
    local deleted_str= added_str= renamed_str= staged_str= unstaged_str=

    [ "$untracked" -gt 0 ]              && { untracked_str="…$untracked "; output=1; }
    [ "$stashed"   -gt 0 ]              && { stash_str="＊$stashed ";      output=1; }
    [ "$behind"    -gt 0 ] 2>/dev/null && { behind_str="↓$behind ";       output=1; }
    [ "$ahead"     -gt 0 ] 2>/dev/null && { ahead_str="↑$ahead ";         output=1; }
    [ "$deleted"   -gt 0 ]              && { deleted_str="✖ $deleted ";    output=1; }
    [ "$added"     -gt 0 ]              && { added_str="✚ $added ";        output=1; }
    [ "$renamed"   -gt 0 ]              && { renamed_str="↪ $renamed ";    output=1; }
    [ "$staged"    -gt 0 ]              && { staged_str="✔ $staged ";      output=1; }
    [ "$unstaged"  -gt 0 ]              && { unstaged_str="✎ $unstaged ";  output=1; }

    #icon=""
    local icon="⎇"
    if [ "0" != "$output" ]; then
        echo "${icon} $(echo -e "${ref_source}: ${ref_name} ${untracked_str}${stash_str}${behind_str}${ahead_str}${deleted_str}${added_str}${renamed_str}${staged_str}${unstaged_str}" | sed -e 's/[[:space:]]*$//')"
    else
        echo "${icon} ${ref_source}: ${ref_name}"
    fi
}
#export -f __git_status
